# Application
APP_NAME=Harmony API
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Base de données PostgreSQL — Supabase
# Remplacez [MOT_DE_PASSE] et [PROJECT_ID] par vos vraies valeurs
DATABASE_URL=postgresql+asyncpg://postgres:[MOT_DE_PASSE]@db.[PROJECT_ID].supabase.co:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Supabase
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxx

# Redis (optionnel en dev, requis en prod)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# JWT — générer avec : openssl rand -hex 32
SECRET_KEY=changeme-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS (séparés par des virgules en JSON)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Firebase (push notifications — laisser vide en dev)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Google Maps (calcul de trajet — laisser vide en dev)
GOOGLE_MAPS_API_KEY=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
